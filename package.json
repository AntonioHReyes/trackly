{
  "name": "@tonyakitori/trackly",
  "version": "0.5.3",
  "description": "Time-tracking CLI with workspaces, projects, tags, rates, PDF/CSV reports, PDF invoices, and an MCP server.",
  "type": "module",
  "license": "MIT",
  "author": "Antonio Huerta Reyes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntonioHReyes/trackly.git"
  },
  "homepage": "https://github.com/AntonioHReyes/trackly#readme",
  "bugs": {
    "url": "https://github.com/AntonioHReyes/trackly/issues"
  },
  "keywords": [
    "cli",
    "time-tracking",
    "toggl",
    "invoicing",
    "mcp",
    "mcp-server"
  ],
  "bin": {
    "tck": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "docs:build": "tsx scripts/build-docs.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0",
    "pdfkit": "^0.15.2",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.13.9",
    "@types/svg-to-pdfkit": "^0.1.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
